class Book:
    def __init__(self,title,author,availble):
        self.title = title
        self.author = author
        self.availbe = availble
    def borrow_book(self):
        if self.availbe :
            self.availbe = False
            print("Book borrowed successfully.")
        else:
            print("Sorry, this book is currently unavailable.")
    def return_book(self):
        if self.availbe :
            self.availbe = True
            print("Book returned successfully.")
        else:
            print("This book was not borrowed.")
    def display_info(self):
        print("Title:", self.title)
        print("Author:", self.author)
        print("Available:", self.availbe)
        print()
Book1 = Book("The Great Gatsby", "F. Scott Fitzgerald", True)
Book2 = Book("To Kill a Mockingbird", "Harper Lee", False)
print("=== Book 1 ===")
Book1.display_info()
Book1.borrow_book()
Book1.display_info()
Book1.return_book()
Book1.display_info()
print("=== Book 2 ===")
Book2.display_info()
Book2.borrow_book()
Book2.display_info()
Book2.return_book()
Book2.display_info()

    
    