class Student:
      def __init__(self,name,age):
            self.name = name
            self.age = age
            self.grade = []
      def add_grade(self,grade):
            self.grade.append(grade)
      def get_average_grade(self):
            return sum(self.grade) / len(self.grade) if self.grade else 0
      def display_info(self):
            print("Name:", self.name)
            print("Age:", str(self.age))
            print("Grades:", str(self.grade))
            print("Average Grade:", str(self.get_average_grade()))
students = []
while True:
      print("\n1. Add Student")
      print("2. Add grade")
      print("3 View all students")
      print("4. Search student")
      print("5. Exit")
      choice = input("Enter your choice: ")
      if choice == '1':
            name = input("Enter student name: ")
            age = int(input("Enter student age: "))
            student = Student(name,age)
            students.append(student)
      elif choice == '2':
            if not students:
                  print("No students available. Please add a student first.")
                  continue
            name = input("Enter student name: ")
            student = next((s for s in students if s.name == name), None)
            if not student:
                  print("Student not found.")
                  continue
            grade = float(input("Enter new grade for the student: "))
            if grade < 0 or grade > 100:
                  print("Invalid grade. Please enter a value between 0 and 100.")
                  continue
            student.add_grade(grade)
            print(f"Updated grade for {student.name}: {student.get_average_grade()}")
      elif choice == '3':
            if not students:
                  print("No students available.")
                  continue
            for student in students:
                  student.display_info()
      elif choice == '4':
            if not students:
                  print("No students available.")
                  continue
            name = input("Enter student name to search: ")
            student = next((s for s in students if s.name == name), None)
            if student:
                  student.display_info()
            else:
                  print("Student not found.")
      elif choice == '5':
            print("Exiting...")
            break
      else:
            print("Invalid choice. Please try again.")
