balance = 1000
real_password = "8468"
attempts = 0


def deposit(balance, amount):
    balance += amount
    print("Deposit successful. New balance:", balance)
    return balance


def withdraw(balance, amount):
    if amount > balance:
        print("Insufficient balance. Withdrawal failed.")
        return balance
    else:
        balance -= amount
        print("Withdrawal successful. New balance:", balance)
        return balance


def check_balance(balance):
    print("Current balance:", balance)


# Password check
while attempts < 5:
    user_password = input("Please enter your password: ")

    if user_password == real_password:
        print("Password correct. Access granted.")
        break
    else:
        attempts += 1
        print("Incorrect password. Attempts left:", 5 - attempts)

if attempts == 5:
    print("Too many failed attempts. Account locked. Try again later.")

else:
    while True:
        print("\nWelcome to the Bank Account Simulator!")
        print("1. Deposit")
        print("2. Withdraw")
        print("3. Check Balance")
        print("4. Exit")

        choice = input("Please select an option (1-4): ")

        if choice == "1":
            amount = int(input("Enter the amount to deposit: "))
            balance = deposit(balance, amount)

        elif choice == "2":
            amount = int(input("Enter the amount to withdraw: "))
            balance = withdraw(balance, amount)

        elif choice == "3":
            check_balance(balance)

        elif choice == "4":
            print("Thank you for using the Bank Account Simulator. Goodbye!")
            break

        else:
            print("Invalid option. Please try again.")